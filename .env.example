# No provider credentials are required for tests or the mock adapter.
# Obvious placeholder only; provider connectivity is not implemented.
PROVIDER_API_KEY=sk-REPLACE_ME
# Explicit opt-in. Default: disabled.
SAINTPETRUS_MOCK=false
NEXT_TELEMETRY_DISABLED=1

# Optional provider selection; leave unset to disable real requests.
# SAINTPETRUS_PROVIDER=openai
# SAINTPETRUS_MODEL=REPLACE_WITH_PROVIDER_MODEL_ID

# Optional client exposure. Restart to change; bus continues while feed is off.
SAINTPETRUS_FEED=false
SAINTPETRUS_EVENT_CAPACITY=500
